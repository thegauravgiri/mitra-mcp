GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ENCRYPTION_KEY=
DATABASE_URL=postgresql://mitra:mitra_pass@localhost:5432/mitradb
POSTGRES_USER=mitra
POSTGRES_PASSWORD=mitra_pass
POSTGRES_DB=mitradb
ALLOWED_HOSTS=*
# Canonical URI of this MCP server, used in OAuth protected-resource metadata
# and validated as required audience is added in a later phase. Defaults to
# "<request base url>/mcp" if unset.
MCP_RESOURCE_URI=

# ── Key vault (envelope encryption + web UI) ────────────────────────────────
# Cloud KMS root key used to wrap per-user data keys, e.g.
# projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
KMS_KEY_RESOURCE_NAME=
# Secret used to HMAC-sign the web vault UI's session cookie.
SESSION_SECRET=
# OAuth redirect URI for the *web vault UI* sign-in flow (distinct from
# GOOGLE_REDIRECT_URI, which is the Calendar-integration callback).
GOOGLE_WEB_REDIRECT_URI=

# ── MCP OAuth authorization-server proxy ────────────────────────────────────
# Secret used to sign the self-issued MCP access tokens (HS256) that Mitra
# hands to MCP clients after they complete Google login via /authorize.
# Also add "<MCP base url>/oauth/callback" to this OAuth client's authorized
# redirect URIs in the Google Cloud Console.
MCP_JWT_SECRET=